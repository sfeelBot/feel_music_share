# feel_music_share/apps/mobile — 필요한 환경값 안내
#
# 이번 라운드(Spotify 전용 세션 MVP 핵심 화면)에서는 아직 react-native-config 등을 도입하지
# 않았고, src/config/env.ts에 하드코딩된 placeholder를 그대로 쓰고 있다. 이 파일은 "다음 단계에서
# .env 기반 설정으로 전환할 때 무엇이 필요한지"를 미리 정리해두는 문서 목적이다.
#
# 실제 값은 여기 채우지 말고(이 파일은 git에 커밋되는 예시 파일), 각자 로컬에서
# .env(gitignore 대상)를 만들어 채울 것을 권장한다.

# --- Spotify (Spotify Developer Dashboard: https://developer.spotify.com/dashboard) ---
# 1. Dashboard에서 새 앱 등록
# 2. Redirect URI로 아래 값을 등록해야 react-native-app-auth의 authorize()가 콜백을 받을 수 있음
#    - feelmusicshare://spotify-auth-callback (Web API OAuth용, Authorization Code + PKCE)
#    - feelmusicshare://spotify-remote-callback (App Remote SDK용 — 아직 미연동, services/spotify/spotifyRemote.ts 참고)
# 3. iOS/Android 앱에 커스텀 URL 스킴(feelmusicshare://)을 등록해야 함 (Info.plist / AndroidManifest.xml, 아직 미설정 — 다음 단계 TODO)
SPOTIFY_CLIENT_ID=

# --- Firebase (Firebase Console: https://console.firebase.google.com) ---
# (2026-07-27 갱신) Realtime Database(RTDB)로 최종 확정 — docs/decision-log.md 참고.
# 1. 프로젝트 생성 완료 (`feel-music-share`).
# 2. iOS 앱 등록 → GoogleService-Info.plist 다운로드 → apps/mobile/ios/mobile/ 에 추가 (아직 안 함,
#    iOS는 구조적으로 검증 불가 상태라 보류 — docs/decisions-needed.md 참고)
# 3. Android 앱 등록(`com.mobile`) → google-services.json 다운로드 →
#    apps/mobile/android/app/google-services.json 에 추가 완료(커밋 2a6f51d).
# 4. Realtime Database 활성화 — 아직 콘솔에서 "데이터베이스 만들기"를 누르지 않은 상태
#    (docs/decision-log.md "후속 조치" 참고). 활성화되면 google-services.json에 RTDB URL이
#    추가되므로 재다운로드가 필요할 가능성이 큼.
# 5. Cloud Functions 프로젝트 초기화 (재생 명령 처리, 클록 오프셋 계산, 권한 검증 등 서버 로직) — 미착수.
#
# 아래 FIREBASE_* 값들은 **현재 필요하지 않다.** `@react-native-firebase`는 모듈러 웹 JS SDK와
# 달리 네이티브 브릿지 방식이라, 네이티브 설정 파일(google-services.json / GoogleService-Info.plist)
# 만 있으면 앱 시작 시 기본 Firebase 앱이 네이티브 레이어에서 자동으로 초기화된다 — JS 코드에서
# apiKey/projectId 등을 다시 넘겨줄 필요가 없다(공식 문서 https://rnfirebase.io/ "Installation" 절
# 참고). 그래서 src/config/env.ts에도 이 값들을 반영하지 않았다. 아래 항목은 향후 참고용으로만
# 남겨둔다 — 실제로 값이 필요해지는 시점(예: 웹 SDK 병행 사용, Cloud Functions REST 호출 등)이
# 오면 그때 다시 채운다.
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=
# FIREBASE_APP_ID=
# FIREBASE_DATABASE_URL=

# --- 설치 완료된 패키지 (2026-07-27) ---
# @react-native-firebase/app@25.1.0, @react-native-firebase/database@25.1.0
# (RN 0.76.9 + New Architecture 조합에서 공식적으로 테스트되는 조합 — rnfirebase.io FAQ 참고)
#
# --- 아직 설치하지 않은 패키지 ---
# react-native-spotify-remote (또는 자체 네이티브 모듈) — App Remote SDK 연동용
